# Chuẩn thụt lề duy nhất cho toàn repo: 4 dấu cách.
# lib/api/ và các route đã viết lại đang dùng 2 dấu cách là nợ tạm thời —
# chuyển về 4 khi có PR sửa các file đó.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false